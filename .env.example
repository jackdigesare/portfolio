# Required — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Optional — defaults to site.email in src/content.ts if unset
CONTACT_TO_EMAIL=

# Optional — defaults to the verified domain from-address in the API route if unset
CONTACT_FROM_EMAIL=

# Required in production — create a Redis database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
